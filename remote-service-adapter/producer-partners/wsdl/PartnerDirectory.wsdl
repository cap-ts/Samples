<?xml version="1.0" encoding="UTF-8"?>
<definitions name="PartnerDirectory"
             targetNamespace="urn:samples:partner-directory"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="urn:samples:partner-directory"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <types>
    <xsd:schema targetNamespace="urn:samples:partner-directory" elementFormDefault="qualified">
      <xsd:complexType name="Contact">
        <xsd:sequence>
          <xsd:element name="Email" type="xsd:string" minOccurs="0"/>
          <xsd:element name="Phone" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Partner">
        <xsd:sequence>
          <xsd:element name="PartnerID" type="xsd:string"/>
          <xsd:element name="Name" type="xsd:string"/>
          <xsd:element name="Country" type="xsd:string"/>
          <xsd:element name="Customer" type="xsd:string" minOccurs="0"/>
          <xsd:element name="Contact" type="tns:Contact" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="GetPartnersRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="PartnerID" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="Country" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="GetPartnersResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Partner" type="tns:Partner" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <message name="GetPartnersInput">
    <part name="parameters" element="tns:GetPartnersRequest"/>
  </message>
  <message name="GetPartnersOutput">
    <part name="parameters" element="tns:GetPartnersResponse"/>
  </message>

  <portType name="PartnerDirectoryPortType">
    <operation name="GetPartners">
      <input message="tns:GetPartnersInput"/>
      <output message="tns:GetPartnersOutput"/>
    </operation>
  </portType>

  <binding name="PartnerDirectoryBinding" type="tns:PartnerDirectoryPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="GetPartners">
      <soap:operation soapAction="urn:samples:partner-directory#GetPartners"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="PartnerDirectory">
    <port name="PartnerDirectoryPort" binding="tns:PartnerDirectoryBinding">
      <soap:address location="http://localhost:6006/soap/partners"/>
    </port>
  </service>
</definitions>
